{"id":"msg-1770081017588-67ufe5","type":"tool","content":"     1→import React, { useState, useCallback, useEffect, useMemo } from 'react';\n     2→import { Canvas } from './components/Canvas';\n     3→import { ContextToolbar } from './components/ContextToolbar';\n     4→import { MediaViewer } from './components/MediaViewer';\n     5→import { NoteViewer } from './components/NoteViewer';\n     6→import { AIModal } from './components/AIModal';\n     7→import { NameEditor } from './components/NameEditor';\n     8→import { SpaceOverview } from './components/SpaceOverview';\n     9→import { SettingsModal } from './components/SettingsModal';\n    10→import { AIPromptPopup } from './components/AIPromptPopup';\n    11→import { AIChat, AIResponse, AIOptions, AI_FORMAT_SYSTEM_PROMPT, parseAIResponse } from './components/AIChat';\n    12→import { QuickGenerate } from './components/QuickGenerate';\n    13→import { AutoArrangeButton } from './components/AutoArrangeButton';\n    14→import { SearchModal } from './components/SearchModal';\n    15→import { useAutoSave } from './hooks/useAutoSave';\n    16→import { useMCPClient } from './hooks/useMCPClient';\n    17→import { useContentZoom } from './hooks/useContentZoom';\n    18→import { loadSpaces, saveSpaces } from './utils/storage';\n    19→import { getFitToViewParams, getLayoutFunction } from './utils/layouts';\n    20→import { Space, SpatialItem, Connection, LayoutType, SortOption, FlowDirection, ItemSpacing } from './types';\n    21→import { ArrowLeft, Menu, Plus, StickyNote, Type, Image as ImageIcon, Layers, SquarePlus, X, LayoutGrid, Zap, Settings, Video, Mic, Search, Globe, Ghost } from 'lucide-react';\n    22→import ELK from 'elkjs';\n    23→import { analyzeImage } from './utils/imageAnalysis';\n    24→import { extractImageMetadata, extractVideoMetadata } from './utils/exifExtractor';\n    25→import { storeFile, isMediaId, getMediaURL } from './lib/mediaStorage';\n    26→import {\n    27→  PaperTexture,\n    28→  MeshGradie