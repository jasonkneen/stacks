{
  "name": "spatial",
  "version": "0.1.0",
  "description": "Spatial canvas workspace for notes, images, and AI-powered organization",
  "author": "Jason Kneen",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "spatial": "./bin/spatial.cjs"
  },
  "files": [
    "bin/",
    "dist/",
    "electron/",
    "mcp/",
    "components/",
    "hooks/",
    "utils/",
    "types.ts",
    "index.tsx",
    "index.html",
    "App.tsx",
    "package.json",
    "vite.config.ts",
    "tsconfig.json",
    "tsconfig.mcp.json",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "npm run clean && NODE_ENV=production vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist node_modules/.vite",
    "electron": "npx electron .",
    "electron:dev": "NODE_ENV=development npx electron .",
    "mcp:dev": "tsx watch mcp/server.ts",
    "mcp:build": "tsc -p tsconfig.mcp.json",
    "mcp:start": "node dist/mcp/server.js",
    "mcp:proxy": "tsx mcp/proxy.ts",
    "mcp:proxy:build": "tsc -p tsconfig.mcp.json && mv dist/mcp/proxy.js dist/mcp/proxy.js 2>/dev/null || true"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.2",
    "@ai-sdk/google": "^3.0.2",
    "@ai-sdk/openai": "^3.0.2",
    "@anthropic-ai/sdk": "^0.71.2",
    "@google/genai": "^1.34.0",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@paper-design/shaders-react": "^0.0.68",
    "@types/better-sqlite3": "^7.6.13",
    "ai": "^6.0.6",
    "better-sqlite3": "^12.5.0",
    "elkjs": "0.9.3",
    "lucide-react": "^0.562.0",
    "openai": "^6.15.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "ws": "^8.18.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.2.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "web-worker": "^1.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jasonkneen/spatial.git"
  },
  "keywords": [
    "spatial",
    "canvas",
    "notes",
    "ai",
    "workspace",
    "electron"
  ]
}
